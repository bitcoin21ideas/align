# Optional local checks for public workflow exports.
# Copy this file to .env and fill in values that must never appear in
# workflows/walks-processing.json. The checker reports variable names only,
# not the configured values.

PUBLIC_WORKFLOW_FORBIDDEN_TEXT_PRIVATE_STORAGE_REPO=
PUBLIC_WORKFLOW_FORBIDDEN_TEXT_PRIVATE_GITHUB_OWNER_URL=
PUBLIC_WORKFLOW_FORBIDDEN_TEXT_GITHUB_CREDENTIAL_LABEL=
PUBLIC_WORKFLOW_FORBIDDEN_TEXT_DEEPGRAM_CREDENTIAL_LABEL=
PUBLIC_WORKFLOW_FORBIDDEN_TEXT_GEMINI_CREDENTIAL_LABEL=
